--><DataType xmlns="http://www.gip.com/xyna/xdev/xfractmod" IsAbstract="false" Label="Prompt Argument" TypeName="PromptArgument" TypePath="xint.mcp.schema" Version="1.8">
  <Meta>
    <IsServiceGroupOnly>false</IsServiceGroupOnly>
  </Meta>
  <Data Label="Name" VariableName="name">
    <Meta>
      <Type>String</Type>
      <Documentation>Intended for programmatic or logical use, but used as a display name in past specs or fallback (if title isn’t present).</Documentation>
    </Meta>
  </Data>
  <Data Label="Title" VariableName="title">
    <Meta>
      <Type>String</Type>
      <Documentation>Intended for UI and end-user contexts — optimized to be human-readable and easily understood, even by those unfamiliar with domain-specific terminology.</Documentation>
    </Meta>
  </Data>
  <Data Label="Description" VariableName="description">
    <Meta>
      <Type>String</Type>
      <Documentation>A human-readable description of the argument.</Documentation>
    </Meta>
  </Data>
  <Data Label="Required" VariableName="required">
    <Meta>
      <Type>Boolean</Type>
      <Documentation>Whether this argument must be provided.</Documentation>
    </Meta>
  </Data>
</DataType>
