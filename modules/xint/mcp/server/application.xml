--><Application applicationName="McpServer" factoryVersion="" versionName="1.0.0" xmlVersion="1.1">
  <ApplicationInfo>
    <Description Lang="DE">Model Context Protocol Server</Description>
    <Description Lang="EN">Model context protocol server</Description>
    <RuntimeContextRequirements>
      <RuntimeContextRequirement>
        <ApplicationName>Http</ApplicationName>
        <VersionName>1.5.11</VersionName>
      </RuntimeContextRequirement>
      <RuntimeContextRequirement>
        <ApplicationName>ModelContextProtocol</ApplicationName>
        <VersionName>1.0.0</VersionName>
      </RuntimeContextRequirement>
    </RuntimeContextRequirements>
  </ApplicationInfo>
  <Filters>
    <Filter implicitDependency="false">
      <Name>McpServerFilter</Name>
      <JarFiles>McpServerFilter/McpServerFilter.jar:</JarFiles>
      <FqFilterClassname>com.gip.xyna.xact.filter.McpServerFilter</FqFilterClassname>
      <TriggerName>Http</TriggerName>
      <SharedLibs/>
    </Filter>
  </Filters>
  <FilterInstances>
    <FilterInstance implicitDependency="false">
      <Name>McpServerFilter</Name>
      <FilterName>McpServerFilter</FilterName>
      <TriggerInstanceName>Http</TriggerInstanceName>
      <FilterConfigurationParameter>endpoint=/mcp</FilterConfigurationParameter>
    </FilterInstance>
  </FilterInstances>
  <TriggerInstances>
    <TriggerInstance implicitDependency="true">
      <Name>Http</Name>
      <TriggerName>Http</TriggerName>
      <StartParameter>port=3000:</StartParameter>
    </TriggerInstance>
  </TriggerInstances>
</Application>
